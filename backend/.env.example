# Port the API server listens on
PORT=4000

# Optional: enable "real" AI image embeddings via Replicate's hosted CLIP model
# instead of the built-in local color/shape fallback.
#
# 1. Create a free account at https://replicate.com and generate an API token
#    (Account settings -> API tokens).
# 2. Paste it below.
# 3. Restart the backend. Startup logs will confirm which embedding
#    provider is active.
#
# The app works perfectly well for demos with this left blank -- it just
# uses the local fallback embedding instead of calling out to Replicate.
REPLICATE_API_TOKEN=

# Optional: override the default CLIP model version used on Replicate.
# Version hashes on Replicate can be superseded over time -- if search logs
# show embedding calls falling back to the local method, check
# https://replicate.com/andreasjansson/clip-features/versions for the
# current latest hash and paste it here.
REPLICATE_MODEL_VERSION=75b33f253f7714a281ad3e9b28f63e3232d583716ef6718f2e46641077ea040a
